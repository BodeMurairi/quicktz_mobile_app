# Database - SQLite for development, switch to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./quicktz.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quicktz_db

# JWT Security
SECRET_KEY=your-very-long-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application
APP_NAME=QuickTZ
APP_VERSION=1.0.0
DEBUG=True

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Cloudflare R2 (S3-compatible object storage) — logos, gallery photos, receipts, invoices, documents
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
